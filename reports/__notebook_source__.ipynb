def iter_s1_chunks(path, chunksize=500_000):
    carry = None
    for ch in pd.read_csv(path, sep="\t", dtype=str, keep_default_na=False, chunksize=chunksize):
        if carry is not None: ch = pd.concat([carry, ch], ignore_index=True)
        last = ch["source1_entity_id"].iloc[-1]
        m = (ch["source1_entity_id"] == last).values
        carry, ch = ch[m], ch[~m]
        if len(ch): yield ch
    if carry is not None and len(carry): yield carry

def load_lookup(paths, wanted):
    parts = []
    for p in paths:
        for ch in pd.read_csv(p, sep="\t", dtype=str, keep_default_na=False,
                              usecols=["entity_id"]+COLS, chunksize=500_000):
            x = ch[ch.entity_id.isin(wanted)]
            if len(x): parts.append(x)
    return pd.concat(parts).set_index("entity_id")

def build_features(df, s1_lk, ot_lk):
    m = (df.merge(s1_lk, left_on="source1_entity_id", right_index=True)
           .rename(columns={COLS[0]:"n1", COLS[1]:"d1", "country":"ca"})
           .merge(ot_lk, left_on="candidate_entity_id", right_index=True)
           .rename(columns={COLS[0]:"n2", COLS[1]:"d2", "country":"cb"}))
    n1, n2, d1, d2 = m.n1.tolist(), m.n2.tolist(), m.d1.tolist(), m.d2.tolist()
    for pre, A, B in (("name", n1, n2), ("addr", d1, d2)):
        m[pre+"_wratio"] = [WRatio(a,b) if a and b else 0 for a,b in zip(A,B)]
        m[pre+"_ratio"]  = [ratio(a,b) if a and b else 0 for a,b in zip(A,B)]
        m[pre+"_tsort"]  = [token_sort_ratio(a,b) if a and b else 0 for a,b in zip(A,B)]
        m[pre+"_tset"]   = [token_set_ratio(a,b) if a and b else 0 for a,b in zip(A,B)]
        m[pre+"_lev"]    = [Levenshtein.normalized_similarity(a,b)*100 if a and b else 0 for a,b in zip(A,B)]
    nm = (m.n1=="")|(m.n2==""); am = (m.d1=="")|(m.d2=="")
    m["name_exact"] = ((m.n1==m.n2)&~nm).astype(int); m["addr_exact"] = ((m.d1==m.d2)&~am).astype(int)
    m["name_missing"] = nm.astype(int); m["addr_missing"] = am.astype(int)
    m["name_len_diff"] = (m.n1.str.len()-m.n2.str.len()).abs()
    m["addr_len_diff"] = (m.d1.str.len()-m.d2.str.len()).abs()
    m["country_match"] = (m.ca==m.cb).astype(int)
    m["shared_name_tokens"] = [len(set(a.split())&set(b.split())) for a,b in zip(n1,n2)]
    m["shared_addr_tokens"] = [len(set(a.split())&set(b.split())) for a,b in zip(d1,d2)]
    feats = [c for c in m.columns if c.startswith(("name_","addr_")) or c in
             ("country_match","shared_name_tokens","shared_addr_tokens","cand_rank")]
    out = m[["source1_entity_id","candidate_entity_id"] + feats].copy()
    for c in feats: out[c] = out[c].astype("float32")
    return out


