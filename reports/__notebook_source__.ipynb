def num_set(s):
    return {t.lstrip("0") or "0" for t in s.split() if t.isdigit()}   # "0016613" -> "16613"

NEW = ["num_both", "num_overlap", "num_a_only", "num_b_only", "num_jacc", "num_conflict"]

def add_num_feats(f):
    f = f.copy()
    a = f.source1_entity_id.map(s1_lk[cols[1]]).fillna("")
    b = f.candidate_entity_id.map(ot_u[cols[1]]).fillna("")
    sa = [num_set(x) for x in a]; sb = [num_set(x) for x in b]
    f["num_both"]    = [int(bool(x and y)) for x, y in zip(sa, sb)]
    f["num_overlap"] = [len(x & y) for x, y in zip(sa, sb)]
    f["num_a_only"]  = [len(x - y) for x, y in zip(sa, sb)]
    f["num_b_only"]  = [len(y - x) for x, y in zip(sa, sb)]
    f["num_jacc"]    = [len(x & y) / len(x | y) if (x | y) else 0 for x, y in zip(sa, sb)]
    f["num_conflict"] = [int(bool(x and y) and bool(x - y) and bool(y - x)) for x, y in zip(sa, sb)]
    for c in NEW: f[c] = f[c].astype("float32")
    return f

tf2 = add_num_feats(tf); vf2 = add_num_feats(vf)
feature_cols2 = feature_cols + NEW
print(tf2.shape, vf2.shape)
print("share of candidates with num_conflict:", round(vf2.num_conflict.mean(), 4))
print("positives with num_conflict:", round(vf2[vf2.label == 1].num_conflict.mean(), 4),
      "| negatives:", round(vf2[vf2.label == 0].num_conflict.mean(), 4))


def run(cols_, seed):
    p = dict(params, seed=seed, bagging_seed=seed, feature_fraction_seed=seed)
    ds = lgb.Dataset(tf2[cols_], label=tf2.label)
    m = lgb.train(p, ds, 500, valid_sets=[lgb.Dataset(vf2[cols_], label=vf2.label, reference=ds)],
                  callbacks=[lgb.early_stopping(30, verbose=False)])
    vf2["_p"] = m.predict(vf2[cols_])
    rr = [dict(t=t, **evaluate(vf2, "_p", 17, t)) for t in TS]
    return m, max(rr, key=lambda x: x["entity_F05"]), rr

rows, models = [], {}
for name, cols_ in (("baseline", feature_cols), ("with_num_feats", feature_cols2)):
    for seed in (1, 2, 3):
        m, bestrow, _ = run(cols_, seed)
        models[(name, seed)] = m
        rows.append(dict(variant=name, seed=seed, **bestrow))
res_df = pd.DataFrame(rows)
print(res_df.round(4).to_string(index=False))
print(res_df.groupby("variant")[["P", "R", "pooled_F05", "entity_F05"]].agg(["mean", "std"]).round(4).T)


m = models[("with_num_feats", 1)]
vf2["p_new"] = m.predict(vf2[feature_cols2])
vf2["p_old"] = model.predict(vf2[feature_cols])          # your submitted model
dd = vf2[vf2.cand_rank < 17]
for lbl, col, t in (("submitted model", "p_old", 0.7), ("with num feats", "p_new", 0.7)):
    sel = dd[dd[col] >= t]
    print(f"{lbl}: FP={int((sel.label==0).sum())}  TP={int((sel.label==1).sum())}  "
          f"FP with num_conflict={int(((sel.label==0)&(sel.num_conflict==1)).sum())}")
imp2 = pd.Series(m.feature_importance("gain"), index=feature_cols2).sort_values(ascending=False)
print((imp2 / imp2.sum()).round(3).head(10))


res_df.to_csv(R/"house_number_experiment.csv", index=False)
imp2.to_csv(R/"feature_importance_v2.csv")
models[("with_num_feats", 1)].save_model(str(R/"matcher_lgbm_v2.txt"))
