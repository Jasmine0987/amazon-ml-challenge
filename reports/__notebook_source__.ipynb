ntrue = pd.Series({s: len(true_map[s]) for s in vs1})

def score_sel(sel):
    g = sel.groupby("source1_entity_id")
    tp = g["label"].sum().reindex(vs1, fill_value=0).values.astype(float)
    npred = g.size().reindex(vs1, fill_value=0).values.astype(float)
    nt = ntrue.values.astype(float)
    P = tp.sum()/max(npred.sum(), 1); R = tp.sum()/nt.sum()
    pooled = 1.25*P*R/(0.25*P+R) if P+R else 0
    p = np.where(npred > 0, tp/np.maximum(npred, 1), 0); r = np.where(nt > 0, tp/np.maximum(nt, 1), 0)
    f = np.where(p+r > 0, 1.25*p*r/np.maximum(0.25*p+r, 1e-12), 0)
    f = np.where(nt == 0, (npred == 0).astype(float), f)
    return dict(P=P, R=R, pooled_F05=pooled, entity_F05=f.mean())

def evaluate(vf, col, Kc, t):
    return score_sel(vf[(vf.cand_rank < Kc) & (vf[col] >= t)])

