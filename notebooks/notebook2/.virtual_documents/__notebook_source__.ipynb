v9_code = r'''
import sys, re, shutil, gzip
import pandas as pd
from pathlib import Path
from collections import defaultdict, Counter

BASE = Path("/kaggle/working")
NORM = BASE / "normalized"
OUT = BASE / "candidates"
OUT.mkdir(parents=True, exist_ok=True)

CHUNK_SIZE = 100_000
MAX_KEY_FREQ = 800
MAX_CANDIDATES = 100
MIN_TOKEN_LEN = 3
MIN_FREE_GB = 2.0

STOPWORDS = {
    "the", "and", "for", "inc", "llc", "ltd", "limited",
    "company", "corp", "corporation", "co", "corporate",
    "group", "services", "service", "solutions", "solution",
    "international", "india", "usa", "us"
}

def clean(x):
    if pd.isna(x): return ""
    x = str(x).strip().lower()
    return "" if x == "nan" else x

def tokens(text):
    text = clean(text)
    if not text: return []
    return [t for t in text.split() if len(t) >= MIN_TOKEN_LEN and t not in STOPWORDS]

def name_keys(name):
    ts = tokens(name)
    if not ts: return []
    keys = set()
    for t in ts: keys.add(("NT", t))
    for t in ts:
        if len(t) >= 5: keys.add(("NP5", t[:5]))
        if len(t) >= 6: keys.add(("NP6", t[:6]))
    if len(name) >= 5: keys.add(("NE", name))
    if len(ts) >= 2: keys.add(("NS", " ".join(sorted(ts))))
    return keys

def address_keys(address):
    address = clean(address)
    if not address: return []
    ts = tokens(address)
    if not ts: return []
    keys = set()
    m = re.search(r"\b\d{1,6}\b", address)
    number = m.group(0) if m else ""
    for t in ts:
        if len(t) >= 4: keys.add(("AT", t))
        if len(t) >= 6: keys.add(("AP6", t[:6]))
    if number:
        for t in ts:
            if len(t) >= 4: keys.add(("AN", number + "|" + t))
    return keys

def all_keys(name, address, country):
    country = clean(country)
    keys = set()
    for k in name_keys(name): keys.add(("C", country) + k)
    for k in address_keys(address): keys.add(("C", country) + k)
    return keys

def build_index(source_path):
    print(f"\nBuilding index (single-pass): {source_path.name}")
    raw_index = defaultdict(list)
    total = 0
    for chunk in pd.read_csv(source_path, sep="\t", dtype=str, keep_default_na=False, chunksize=CHUNK_SIZE):
        for row in chunk.itertuples(index=False):
            name = clean(row.business_name_normalized)
            address = clean(row.business_address_normalized)
            country = clean(row.country)
            entity_id = row.entity_id
            for key in all_keys(name, address, country):
                raw_index[key].append(entity_id)
        total += len(chunk)
        print(f"Scanned+Indexed {total:,} rows")
    print(f"Unique keys before filtering: {len(raw_index):,}")
    index = {key: ids for key, ids in raw_index.items() if len(ids) <= MAX_KEY_FREQ}
    del raw_index
    print(f"Final index keys: {len(index):,}")
    return index

def check_disk_ok():
    free_gb = shutil.disk_usage("/kaggle/working").free / (1024**3)
    return free_gb, free_gb >= MIN_FREE_GB

def generate_for_source1(s1_path, s2_index, s3_index, output_path, sample_limit=None):
    print(f"\nGenerating candidates from {s1_path.name}")
    total_s1 = 0
    total_candidates = 0
    with gzip.open(str(output_path) + ".gz", "wt") as out:
        out.write("source1_entity_id\tcandidate_entity_id\tscore\n")
        for chunk in pd.read_csv(s1_path, sep="\t", dtype=str, keep_default_na=False, chunksize=CHUNK_SIZE):
            for row in chunk.itertuples(index=False):
                s1_id = row.entity_id
                name = clean(row.business_name_normalized)
                address = clean(row.business_address_normalized)
                country = clean(row.country)
                keys = all_keys(name, address, country)
                scores = Counter()
                for key in keys:
                    for candidate in s2_index.get(key, ()):
                        scores[candidate] += 1
                    for candidate in s3_index.get(key, ()):
                        scores[candidate] += 1
                if scores:
                    ranked = sorted(scores.items(), key=lambda x: (-x[1], x[0]))
                    candidates = ranked[:MAX_CANDIDATES]
                    for candidate, score in candidates:
                        out.write(f"{s1_id}\t{candidate}\t{score}\n")
                    total_candidates += len(candidates)
                total_s1 += 1
                if total_s1 % 10_000 == 0:
                    avg = total_candidates / total_s1
                    print(f"S1 processed: {total_s1:,} | avg candidates: {avg:.1f}")
                if total_s1 % 100_000 == 0:
                    free_gb, ok = check_disk_ok()
                    print(f"  [disk check] {free_gb:.2f} GB free")
                    if not ok:
                        print(f"STOPPING: free space {free_gb:.2f} GB below {MIN_FREE_GB} GB threshold.")
                        return total_s1, total_candidates
                if sample_limit and total_s1 >= sample_limit:
                    print(f"\nSample limit reached: {sample_limit:,}")
                    return total_s1, total_candidates
    return total_s1, total_candidates

def main():
    if len(sys.argv) < 3:
        print("Usage: python build_candidates_v9.py <train|test> <50000|full>")
        sys.exit(1)
    split, mode = sys.argv[1], sys.argv[2]
    prefix = "train" if split == "train" else "test"
    s1 = NORM / f"{prefix}_source1_normalized.tsv"
    s2 = NORM / f"{prefix}_source2_normalized.tsv"
    s3 = NORM / f"{prefix}_source3_normalized.tsv"
    print("Building S2 index...")
    s2_index = build_index(s2)
    print("\nBuilding S3 index...")
    s3_index = build_index(s3)
    sample_limit = None if mode == "full" else int(mode)
    output = OUT / f"raw_candidates_v9_{prefix}_{mode}.tsv"
    processed, candidates = generate_for_source1(s1, s2_index, s3_index, output, sample_limit)
    print("\n==============================")
    print("V9 COMPLETE")
    print("==============================")
    print(f"S1 processed: {processed:,}")
    print(f"Candidates:    {candidates:,}")
    if processed:
        print(f"Average candidates/S1: {candidates / processed:.2f}")
    print(f"Output: {output}.gz")

if __name__ == "__main__":
    main()
'''
