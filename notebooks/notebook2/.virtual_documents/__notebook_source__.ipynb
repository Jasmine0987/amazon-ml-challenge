def entity_f_beta(df, threshold, beta=0.5):
    tp = fp = fn = 0
    for s1_id, g in df.groupby("source1_entity_id"):
        predicted = set(g.loc[g["prob"] >= threshold, "candidate_entity_id"])
        actual = set(g.loc[g["label"] == 1, "candidate_entity_id"])
        tp += len(predicted & actual)
        fp += len(predicted - actual)
        fn += len(actual - predicted)
    precision = tp / (tp + fp) if (tp + fp) else 0
    recall = tp / (tp + fn) if (tp + fn) else 0
    if precision + recall == 0:
        return 0, precision, recall
    fbeta = (1 + beta**2) * precision * recall / (beta**2 * precision + recall)
    return fbeta, precision, recall

