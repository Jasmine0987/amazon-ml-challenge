def subsample(df, neg_per_pos=15, seed=42):
    pos = df[df["label"] == 1]
    neg = df[df["label"] == 0]
    n_keep = min(len(neg), len(pos) * neg_per_pos)
    neg_sorted = neg.sort_values("score", ascending=False)
    hard_neg = neg_sorted.head(n_keep // 2)
    rest_pool = neg_sorted.iloc[n_keep // 2:]
    random_neg = rest_pool.sample(n=min(len(rest_pool), n_keep - len(hard_neg)), random_state=seed)
    return pd.concat([pos, hard_neg, random_neg]).sample(frac=1, random_state=seed)

