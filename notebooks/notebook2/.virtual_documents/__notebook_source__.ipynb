        })
        .merge(other_lookup, left_on="candidate_entity_id", right_index=True)
        .rename(columns={
            "business_name_normalized": "n2",
            "business_address_normalized": "d2",
            "country": "country_b"
        })
    )
    merged[["n1", "d1", "n2", "d2"]] = merged[["n1", "d1", "n2", "d2"]].fillna("")

    name_missing = (merged["n1"] == "") | (merged["n2"] == "")
    addr_missing = (merged["d1"] == "") | (merged["d2"] == "")

    n1, n2 = merged["n1"].tolist(), merged["n2"].tolist()
    d1, d2 = merged["d1"].tolist(), merged["d2"].tolist()

    merged["name_wratio"] = [WRatio(a, b) if a and b else 0 for a, b in zip(n1, n2)]
    merged["name_ratio"]  = [ratio(a, b) if a and b else 0 for a, b in zip(n1, n2)]
    merged["name_tsort"]  = [token_sort_ratio(a, b) if a and b else 0 for a, b in zip(n1, n2)]
    merged["name_tset"]   = [token_set_ratio(a, b) if a and b else 0 for a, b in zip(n1, n2)]
    merged["name_lev"]    = [Levenshtein.normalized_similarity(a, b) * 100 if a and b else 0 for a, b in zip(n1, n2)]

    merged["addr_wratio"] = [WRatio(a, b) if a and b else 0 for a, b in zip(d1, d2)]
    merged["addr_ratio"]  = [ratio(a, b) if a and b else 0 for a, b in zip(d1, d2)]
    merged["addr_tsort"]  = [token_sort_ratio(a, b) if a and b else 0 for a, b in zip(d1, d2)]
    merged["addr_tset"]   = [token_set_ratio(a, b) if a and b else 0 for a, b in zip(d1, d2)]
    merged["addr_lev"]    = [Levenshtein.normalized_similarity(a, b) * 100 if a and b else 0 for a, b in zip(d1, d2)]

    merged["name_exact"] = ((merged["n1"] == merged["n2"]) & ~name_missing).astype(int)
    merged["addr_exact"] = ((merged["d1"] == merged["d2"]) & ~addr_missing).astype(int)
    merged["name_missing"] = name_missing.astype(int)
    merged["addr_missing"] = addr_missing.astype(int)
    merged["name_len_diff"] = (merged["n1"].str.len() - merged["n2"].str.len()).abs()
    merged["addr_len_diff"] = (merged["d1"].str.len() - merged["d2"].str.len()).abs()
    merged["country_match"] = (merged["country_a"] == merged["country_b"]).astype(int)
    merged["shared_name_tokens"] = [len(set(a.split()) & set(b.split())) for a, b in zip(n1, n2)]
    merged["shared_addr_tokens"] = [len(set(a.split()) & set(b.split())) for a, b in zip(d1, d2)]
    merged = merged.rename(columns={"score": "blocking_score"})

    keep = ["source1_entity_id", "candidate_entity_id", "label", "blocking_score",
            "name_wratio", "name_ratio", "name_tsort", "name_tset", "name_lev",
            "name_exact", "name_missing", "name_len_diff",
            "addr_wratio", "addr_ratio", "addr_tsort", "addr_tset", "addr_lev",
            "addr_exact", "addr_missing", "addr_len_diff",
            "country_match", "shared_name_tokens", "shared_addr_tokens"]
    return merged[keep]

