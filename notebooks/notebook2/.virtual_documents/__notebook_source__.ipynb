    merged["addr_tsort"]  = [token_sort_ratio(a, b) if a and b else 0 for a, b in zip(d1, d2)]
    merged["addr_tset"]   = [token_set_ratio(a, b) if a and b else 0 for a, b in zip(d1, d2)]
    merged["addr_lev"]    = [Levenshtein.normalized_similarity(a, b) * 100 if a and b else 0 for a, b in zip(d1, d2)]
    merged["name_exact"] = ((merged["n1"] == merged["n2"]) & ~name_missing).astype(int)
    merged["addr_exact"] = ((merged["d1"] == merged["d2"]) & ~addr_missing).astype(int)
    merged["name_missing"] = name_missing.astype(int)
    merged["addr_missing"] = addr_missing.astype(int)
    merged["name_len_diff"] = (merged["n1"].str.len() - merged["n2"].str.len()).abs()
    merged["addr_len_diff"] = (merged["d1"].str.len() - merged["d2"].str.len()).abs()
    merged["country_match"] = (merged["country_a"] == merged["country_b"]).astype(int)
    merged["shared_name_tokens"] = [len(set(a.split()) & set(b.split())) for a, b in zip(n1, n2)]
    merged["shared_addr_tokens"] = [len(set(a.split()) & set(b.split())) for a, b in zip(d1, d2)]
    merged = merged.rename(columns={"score": "blocking_score"})
    keep = ["source1_entity_id", "candidate_entity_id", "label", "blocking_score",
            "name_wratio", "name_ratio", "name_tsort", "name_tset", "name_lev", "name_exact", "name_missing", "name_len_diff",
            "addr_wratio", "addr_ratio", "addr_tsort", "addr_tset", "addr_lev", "addr_exact", "addr_missing", "addr_len_diff",
            "country_match", "shared_name_tokens", "shared_addr_tokens"]
    return merged[keep]

feature_cols = ["blocking_score", "name_wratio", "name_ratio", "name_tsort", "name_tset", "name_lev",
                "name_exact", "name_missing", "name_len_diff", "addr_wratio", "addr_ratio", "addr_tsort",
                "addr_tset", "addr_lev", "addr_exact", "addr_missing", "addr_len_diff",
                "country_match", "shared_name_tokens", "shared_addr_tokens"]

params = {
    "objective": "binary", "metric": "average_precision", "num_leaves": 63,
    "learning_rate": 0.05, "feature_fraction": 0.9, "bagging_fraction": 0.8,
    "bagging_freq": 5, "is_unbalance": True, "n_jobs": -1, "verbose": -1,
}
print("Functions ready.")


import numpy as np
from pathlib import Path

NORM = Path("/kaggle/working/normalized")
CAND_DIR = Path("/kaggle/working/candidates")
CAND_FULL_GZ = CAND_DIR / "raw_candidates_v9_train_full.tsv.gz"

gt_full = pd.read_csv(FILES["train_ground_truth.tsv"], sep="\t", dtype=str, keep_default_na=False)
true_map_full = {
    r.source1_entity_id: set(x.strip() for x in r.matched_entity_ids.split(",") if x.strip())
    for r in gt_full.itertuples(index=False)
}

all_s1_ids = pd.read_csv(NORM / "train_source1_normalized.tsv", sep="\t", dtype=str, usecols=["entity_id"])["entity_id"].values
rng = np.random.default_rng(42)
shuffled = all_s1_ids.copy()
rng.shuffle(shuffled)
n_val = int(len(shuffled) * 0.1)
val_s1_full = set(shuffled[:n_val])
train_s1_full = set(shuffled[n_val:])

NEG_PER_POS_TRAIN, NEG_PER_POS_VAL, CHUNKSIZE = 8, 15, 500_000
TRAIN_POS_CAP, VAL_POS_CAP = 400_000, 60_000
train_out = CAND_DIR / "labeled_subsampled_train_full.tsv"
val_out = CAND_DIR / "labeled_subsampled_val_full.tsv"
rng2 = np.random.default_rng(123)
total_pos_train = total_neg_train = total_pos_val = total_neg_val = 0

def subsample_and_write(sub_df, out_path, neg_per_pos, write_header, remaining_pos_budget):
    pos = sub_df[sub_df["label"] == 1]
    neg = sub_df[sub_df["label"] == 0]
    if remaining_pos_budget <= 0:
        return 0, 0
    if len(pos) > remaining_pos_budget:
        pos = pos.sample(n=remaining_pos_budget, random_state=int(rng2.integers(0, 1_000_000)))
    n_keep = min(len(neg), len(pos) * neg_per_pos)
    if n_keep > 0:
        neg_sorted = neg.sort_values("score", ascending=False)
        hard_neg = neg_sorted.head(n_keep // 2)
        rest_pool = neg_sorted.iloc[n_keep // 2:]
        take = min(len(rest_pool), n_keep - len(hard_neg))
        random_neg = rest_pool.sample(n=take, random_state=int(rng2.integers(0, 1_000_000))) if take > 0 else rest_pool.iloc[0:0]
        keep = pd.concat([pos, hard_neg, random_neg])
    else:
        keep = pos
    keep.to_csv(out_path, sep="\t", index=False, header=write_header, mode="w" if write_header else "a")
    return len(pos), len(keep) - len(pos)

first_write = True
chunk_num = 0
for chunk in pd.read_csv(CAND_FULL_GZ, sep="\t", dtype=str, keep_default_na=False, compression="gzip", chunksize=CHUNKSIZE):
    chunk_num += 1
    chunk["score"] = chunk["score"].astype(int)
    chunk["label"] = chunk.apply(lambda r: 1 if r.candidate_entity_id in true_map_full.get(r.source1_entity_id, set()) else 0, axis=1)
    is_train = chunk["source1_entity_id"].isin(train_s1_full)
    p, n = subsample_and_write(chunk[is_train], train_out, NEG_PER_POS_TRAIN, first_write, TRAIN_POS_CAP - total_pos_train)
    total_pos_train += p; total_neg_train += n
    p, n = subsample_and_write(chunk[~is_train], val_out, NEG_PER_POS_VAL, first_write, VAL_POS_CAP - total_pos_val)
    total_pos_val += p; total_neg_val += n
    first_write = False
    if chunk_num % 10 == 0:
        print(f"Chunk {chunk_num}: train_pos={total_pos_train:,} val_pos={total_pos_val:,}")
    if total_pos_train >= TRAIN_POS_CAP and total_pos_val >= VAL_POS_CAP:
        print(f"Caps reached at chunk {chunk_num}. Stopping.")
        break

print(f"\nTrain: {total_pos_train:,} pos + {total_neg_train:,} neg")
print(f"Val: {total_pos_val:,} pos + {total_neg_val:,} neg")


train_pairs_full = pd.read_csv(train_out, sep="\t", dtype=str, keep_default_na=False)
val_pairs_full = pd.read_csv(val_out, sep="\t", dtype=str, keep_default_na=False)
for df in [train_pairs_full, val_pairs_full]:
    df["score"] = df["score"].astype(int)
    df["label"] = df["label"].astype(int)

all_s1_needed = set(train_pairs_full["source1_entity_id"]) | set(val_pairs_full["source1_entity_id"])
all_other_needed = set(train_pairs_full["candidate_entity_id"]) | set(val_pairs_full["candidate_entity_id"])
s1_lookup = load_lookup(NORM / "train_source1_normalized.tsv", all_s1_needed)
s2_lookup = load_lookup(NORM / "train_source2_normalized.tsv", all_other_needed)
s3_lookup = load_lookup(NORM / "train_source3_normalized.tsv", all_other_needed)
print("Lookups ready:", len(s1_lookup), len(s2_lookup), len(s3_lookup))


train_feat_full = build_features_fast(train_pairs_full)
val_feat_full = build_features_fast(val_pairs_full)
for col in train_feat_full.select_dtypes(include="float64").columns:
    train_feat_full[col] = train_feat_full[col].astype("float32")
for col in val_feat_full.select_dtypes(include="float64").columns:
    val_feat_full[col] = val_feat_full[col].astype("float32")
print("Features:", train_feat_full.shape, val_feat_full.shape)


import lightgbm as lgb
X_train_full, y_train_full = train_feat_full[feature_cols], train_feat_full["label"]
X_val_full, y_val_full = val_feat_full[feature_cols], val_feat_full["label"]
train_set_full = lgb.Dataset(X_train_full, label=y_train_full)
val_set_full = lgb.Dataset(X_val_full, label=y_val_full, reference=train_set_full)
model_full = lgb.train(params, train_set_full, num_boost_round=500, valid_sets=[val_set_full],
                        callbacks=[lgb.early_stopping(30), lgb.log_evaluation(20)])
model_full.save_model("/kaggle/working/code/matcher_lgbm_full.txt")
print("Model trained.")


val_feat_full["prob"] = model_full.predict(X_val_full)
results_full = []
for t in [0.50, 0.60, 0.70, 0.80, 0.85, 0.90, 0.95]:
    f, p, r = entity_f_beta(val_feat_full, t)
    results_full.append((t, f, p, r))
    print(f"threshold={t:.2f} F0.5={f:.4f} precision={p:.4f} recall={r:.4f}")
BEST_THRESHOLD_FULL = max(results_full, key=lambda x: x[1])[0]
print("Best threshold:", BEST_THRESHOLD_FULL)


